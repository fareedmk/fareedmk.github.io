# Local development only. Generate independent random values; never use examples in production.
# Use URL-safe hexadecimal for POSTGRES_PASSWORD and substitute the same value in DATABASE_URL.
POSTGRES_PASSWORD=replace-with-random-local-database-password
DATABASE_URL=REPLACE_WITH_POSTGRES_CONNECTION_STRING

# Only mock is enabled in this delivery. Sandbox/production must fail closed.
CLOVER_MODE=mock
APP_ORIGIN=http://localhost:3000
LOCATION_ID=yafi-main
# At least 12 characters; no default login. Use a password manager.
ADMIN_PASSWORD=replace-with-long-random-owner-password

# Public branding, baked into the browser bundle at build time. Never place secrets here.
NEXT_PUBLIC_BUSINESS_NAME=YaFI
# Optional root-relative image path in public/, e.g. /brand-logo.svg; rebuild after changes.
NEXT_PUBLIC_LOGO_PATH=

# No Clover credentials are needed or consumed by the mock adapter.
# Do not put private Clover keys or card data in NEXT_PUBLIC_* variables.
# Live OAuth secret encryption, MFA/OIDC, email/SMS delivery, and Clover device IDs
# require separate implementation and acceptance; see docs/operations.txt.
